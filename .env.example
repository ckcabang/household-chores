# Copy to .env for local overrides. All values here are safe placeholders.
# The app runs with no .env at all (SQLite, DEBUG on, insecure dev key).

# Secret key. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-dev-key-change-me

# Debug mode. Must be false in production.
DEBUG=true

# Comma-separated hostnames Django will serve. Required when DEBUG=false.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database connection URL. Omit to use the local SQLite file.
# Postgres example:
# DATABASE_URL=postgres://user:password@localhost:5432/household_chores

# Anthropic API key for AI setup (chores/ai/). Without it the /setup/ page
# shows a friendly "not configured" message; the rest of the app is unaffected.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for AI setup.
# ANTHROPIC_MODEL=claude-opus-5

# --- Production (DEBUG=false) -------------------------------------------------
# With DEBUG=false, ALLOWED_HOSTS and a Postgres DATABASE_URL are REQUIRED and
# the app fails fast at startup if either is missing.

# TLS/proxy security. Defaults follow DEBUG (all on when DEBUG=false).
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# Enable HSTS only once you're sure HTTPS is permanent (seconds; try 3600 first).
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
# Set when a proxy terminates TLS and forwards X-Forwarded-Proto (most PaaS).
# SECURE_PROXY_SSL_HEADER=true
